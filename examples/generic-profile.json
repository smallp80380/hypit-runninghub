{
  "format": "hypit.runtime-local@1",
  "dataRoot": "./state",
  "credentials": {
    "env": {
      "use": "@hypit/credential-store-env",
      "config": {}
    }
  },
  "endpoints": {
    "runninghub.account": {
      "use": "@local/provider-runninghub",
      "config": {
        "schemaVersion": "hypit-runninghub.config@2",
        "family": "native-workflow",
        "baseUrl": "https://www.runninghub.ai",
        "apiKey": {
          "store": "platform",
          "key": "runninghub.example"
        },
        "keyType": "unknown",
        "accountPreflight": {
          "mode": "read-only-required"
        },
        "billingExpectation": {
          "policy": "COINS_ONLY",
          "ledger": "coins",
          "gate": "require-provider-guarantee"
        },
        "liveBillingEvidence": {
          "kind": "none"
        },
        "submissionEnabled": false,
        "retry": {
          "submit": {
            "maxAttempts": 3,
            "initialDelayMs": 2000,
            "maxDelayMs": 15000
          },
          "upload": {
            "maxAttempts": 3,
            "initialDelayMs": 2000,
            "maxDelayMs": 15000
          }
        },
        "polling": {
          "intervalMs": 5000,
          "maxElapsedMs": 1800000,
          "maxConsecutiveTransientFailures": 5
        },
        "http": {
          "requestTimeoutMs": 60000,
          "maxResponseBytes": 1048576,
          "maxDownloadBytes": 1073741824,
          "allowedDownloadHosts": [
            "example.invalid"
          ]
        },
        "paths": {
          "journalDirectory": "provider-runninghub/operations"
        },
        "native": {
          "uploadProtocol": "legacy-filename",
          "submitProtocol": "legacy-create",
          "queryProtocol": "v2-query"
        },
        "budgets": {
          "maxRequestBytes": 4194304,
          "maxJournalBytes": 33554432
        }
      }
    }
  },
  "bindings": {
    "@local/provider-runninghub@1#run-workflow": "runninghub.account"
  }
}
