{
  "schemaVersion": "hypit-runninghub.config@1",
  "family": "standard-model",
  "baseUrl": "https://www.runninghub.cn/openapi/v2",
  "apiKey": {
    "store": "platform",
    "key": "runninghub.example"
  },
  "keyType": "Enterprise-Shared",
  "accountPreflight": {
    "mode": "read-only-required"
  },
  "billingExpectation": {
    "policy": "COINS_ONLY",
    "ledger": "coins",
    "gate": "require-provider-guarantee"
  },
  "liveBillingEvidence": {
    "kind": "none"
  },
  "submissionEnabled": false,
  "retry": {
    "submit": {
      "maxAttempts": 3,
      "initialDelayMs": 2000,
      "maxDelayMs": 15000
    },
    "upload": {
      "maxAttempts": 3,
      "initialDelayMs": 2000,
      "maxDelayMs": 15000
    }
  },
  "polling": {
    "intervalMs": 5000,
    "maxElapsedMs": 1800000,
    "maxConsecutiveTransientFailures": 5
  },
  "http": {
    "requestTimeoutMs": 60000,
    "maxResponseBytes": 1048576,
    "maxDownloadBytes": 1073741824,
    "allowedDownloadHosts": [
      "example.invalid"
    ]
  },
  "paths": {
    "journalDirectory": "provider-runninghub/operations"
  },
  "standard": {
    "registrySha256": "61b682b097fdf8766a70c774464b3682ca2494b0f2a0d8de105bd0a77c825a1a",
    "modelDescriptors": [
      "descriptors/registry-image-model.json"
    ]
  }
}
