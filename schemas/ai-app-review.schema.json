{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "REVIEWED_AI_APP_OPERATION@1"
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "store": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "store",
            "key"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "reference",
        "sha256"
      ]
    },
    "accessPasswordCredential": {
      "$ref": "#/properties/credential"
    },
    "baseUrl": {
      "enum": [
        "https://www.runninghub.ai",
        "https://www.runninghub.cn"
      ]
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileDigests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "key",
          "sha256"
        ]
      }
    },
    "scope": {
      "const": "reviewed-ai-app-only-no-external-money"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "const": "https://www.runninghub.ai/enterprise-api/consumerApi"
        },
        "noteSha256": {
          "const": "becf0e9cb51ceee2460b77ebeddc394343e7e982f9fdbb029a3e6e4055386097"
        }
      },
      "required": [
        "url",
        "noteSha256"
      ]
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "project-owner-reviewed-membership-key-and-ai-app"
        },
        "recordId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        },
        "reviewer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        },
        "reviewedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        }
      },
      "required": [
        "kind",
        "recordId",
        "reviewer",
        "reviewedAt"
      ]
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "appDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "format",
    "credential",
    "baseUrl",
    "requestDigest",
    "appDigest",
    "fileDigests",
    "scope",
    "source",
    "humanReview",
    "expiresAt"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hypit-runninghub:ai-app-review:1",
  "title": "Private owner review of an AI App interface and Membership key; not a hidden graph or backend entitlement guarantee"
}
