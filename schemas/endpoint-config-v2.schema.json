{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "hypit-runninghub.config@2"
    },
    "family": {
      "const": "native-workflow"
    },
    "baseUrl": {
      "enum": [
        "https://www.runninghub.ai",
        "https://www.runninghub.cn"
      ]
    },
    "apiKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "store",
        "key"
      ]
    },
    "accessPassword": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store": { "type": "string", "minLength": 1, "maxLength": 200 },
        "key": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["store", "key"]
    },
    "keyType": {
      "enum": [
        "Consumer-Member",
        "Enterprise-Shared",
        "Enterprise-Dedicated",
        "unknown"
      ]
    },
    "accountPreflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "read-only-required"
        }
      },
      "required": [
        "mode"
      ]
    },
    "billingExpectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "const": "COINS_ONLY"
        },
        "ledger": {
          "const": "coins"
        },
        "gate": {
          "const": "require-provider-guarantee"
        }
      },
      "required": [
        "policy",
        "ledger",
        "gate"
      ]
    },
    "liveBillingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "none"
        }
      },
      "required": [
        "kind"
      ]
    },
    "submissionEnabled": {
      "type": "boolean"
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAttempts": {
              "const": 3
            },
            "initialDelayMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "maxDelayMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "required": [
            "maxAttempts",
            "initialDelayMs",
            "maxDelayMs"
          ]
        },
        "upload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAttempts": {
              "const": 3
            },
            "initialDelayMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "maxDelayMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          },
          "required": [
            "maxAttempts",
            "initialDelayMs",
            "maxDelayMs"
          ]
        }
      },
      "required": [
        "submit",
        "upload"
      ]
    },
    "polling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervalMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "maxElapsedMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maxConsecutiveTransientFailures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "intervalMs",
        "maxElapsedMs",
        "maxConsecutiveTransientFailures"
      ]
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "maxDownloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "allowedDownloadHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "requestTimeoutMs",
        "maxResponseBytes",
        "maxDownloadBytes",
        "allowedDownloadHosts"
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "journalDirectory": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$",
          "maxLength": 300
        }
      },
      "required": [
        "journalDirectory"
      ]
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uploadProtocol": {
          "const": "legacy-filename"
        },
        "submitProtocol": {
          "const": "legacy-create"
        },
        "queryProtocol": {
          "const": "v2-query"
        }
      },
      "required": [
        "uploadProtocol",
        "submitProtocol",
        "queryProtocol"
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 4194304
        },
        "maxJournalBytes": {
          "type": "integer",
          "minimum": 69632,
          "maximum": 67108864
        }
      },
      "required": [
        "maxRequestBytes",
        "maxJournalBytes"
      ],
      "description": "Semantic validator also requires >=max(4*maxRequestBytes+65536,2*http.maxResponseBytes+65536)."
    }
  },
  "required": [
    "schemaVersion",
    "family",
    "baseUrl",
    "apiKey",
    "keyType",
    "accountPreflight",
    "billingExpectation",
    "liveBillingEvidence",
    "submissionEnabled",
    "retry",
    "polling",
    "http",
    "paths",
    "native",
    "budgets"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hypit-runninghub:endpoint-config:2",
  "title": "Generic native account Endpoint, no workflow descriptor"
}
