{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "hypit-runninghub.model@1"
    },
    "execution": {
      "const": "deferred-coins-only"
    },
    "registryEndpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "registrySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entrySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "module",
        "name"
      ]
    },
    "portTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "result": {
          "enum": [
            "image",
            "video"
          ]
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "maxItems": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              },
              "value": {
                "oneOf": [
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "text"
                          },
                          "maxChars": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "enum"
                          },
                          "values": {
                            "type": "array",
                            "items": {
                              "type": [
                                "string",
                                "number"
                              ]
                            },
                            "minItems": 1,
                            "uniqueItems": true
                          }
                        },
                        "required": [
                          "kind",
                          "values"
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "number"
                          },
                          "integer": {
                            "type": "boolean"
                          },
                          "minimum": {
                            "type": "number"
                          },
                          "maximum": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "boolean"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "media"
                      },
                      "accepts": {
                        "const": [
                          "image"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "accepts"
                    ]
                  }
                ]
              }
            },
            "required": [
              "name",
              "minItems",
              "maxItems",
              "value"
            ]
          }
        },
        "requires": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "model",
        "result",
        "ports",
        "requires"
      ]
    },
    "fieldMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "port": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fieldKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mode": {
            "enum": [
              "scalar",
              "url",
              "urlArray"
            ]
          }
        },
        "required": [
          "port",
          "fieldKey",
          "mode"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "execution",
    "registryEndpoint",
    "registrySha256",
    "entrySha256",
    "capability",
    "portTable",
    "fieldMappings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hypit-runninghub:registry-descriptor:1",
  "title": "Stage 1 registry extension contract; Model execution deferred for Coins-only"
}
